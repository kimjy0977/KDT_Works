---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	dispatch(dispatch)
	researcher(researcher)
	review(review)
	compose(compose)
	evaluate(evaluate)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	compose --> evaluate;
	dispatch -.-> researcher;
	dispatch -.-> review;
	plan -.-> dispatch;
	researcher --> review;
	review -.-> compose;
	review -.-> dispatch;
	evaluate --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
