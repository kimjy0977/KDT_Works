# 복사해서 .env 로 쓰세요. .env 는 .gitignore 에 있습니다.
# ★웹훅 URL 은 «주소 자체가 열쇠»입니다 — 코드·깃허브·노션에 절대 적지 마세요.
DISCORD_WEBHOOK_URL=

# 보낼지 말지. 기본은 «보내지 않음»(1) 입니다.
#   되돌릴 수 없는 단계는 발행 하나뿐이라, 실수로 보내는 쪽보다
#   안 보내는 쪽이 덜 나쁩니다. 그래서 «끄는» 쪽을 기본값으로 뒀습니다.
# ⚠ run.py 로 돌리면 이 값은 «무시»됩니다 — run.py 가 --send 유무로 직접 정합니다.
#   여기 값이 쓰이는 건 graph.py 를 직접 import 해서 쓸 때뿐입니다.
#   실제 발행은 파일을 고치지 말고  python run.py --send  를 쓰세요.
DRY_RUN=1

# 아래 둘은 «없어도 됩니다». 없으면 로컬 Ollama 로 돕니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_MODEL=qwen2.5:3b
