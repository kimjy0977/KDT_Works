#!/bin/sh
# KDT pre-commit v4 — **혼합 스코프 커밋 거부** (세션 정체 불필요)
# 근거: 토론 TH-20260823-INFRA / v1~v3 결함을 실사용에서 연속 발견 후 재설계
#
# ★왜 세션 정체를 안 쓰는가 (v3까지의 실패)
#   v2 `.kdt-session` 파일 → 공유 clone에 파일 1개라 남이 덮어씀(실제 발생)
#   v3 $KDT_SESSION export → Bash 도구가 **호출마다 새 셸**이라 안 남음(튜터 실측)
#   → "3세션 1 clone"엔 **세션별 상태를 둘 곳이 자체가 없다.**
#
# ★그래서 질문을 바꾼다: "너 누구냐"(불가) → **"이 커밋이 스코프를 섞었냐"**(가능)
#   실제 사고 2건은 전부 **한 커밋에 두 스코프가 섞인 것**이었다:
#     · 매니저 08-23: 폴더개명(구조) + 게임코드(해커톤)
#     · 튜터 08-19: 문서(튜터) + 해커톤 미완성 파일
#   혼합만 막으면 **정체를 몰라도 두 사고가 다 걸린다.**

FILES=$(git diff --cached --name-only)
[ -z "$FILES" ] && exit 0

SCOPES=""
for f in $FILES; do
  case "$f" in
    90_hackathon/*)                         S=hackathon ;;
    00_log/*|01_onboarding/*|02_module1/*|03_module2/*|99_domain-dev/*) S=content ;;
    index.html|README.md|assets/*|.githooks/*|.gitignore|.kdt-session*) S=structure ;;
    *)                                      S=other ;;
  esac
  case " $SCOPES " in *" $S "*) ;; *) SCOPES="$SCOPES $S" ;; esac
done

N=$(echo $SCOPES | wc -w)
if [ "$N" -gt 1 ]; then
  echo "[거부] 한 커밋에 스코프가 $N 개 섞였습니다:$SCOPES"
  echo ""
  git diff --cached --name-only | sed 's/^/   /'
  echo ""
  echo "실제 사고 2건이 전부 이 형태였습니다(개명 커밋에 게임코드 / 문서 커밋에 미완성 파일)."
  echo "-> 스코프별로 나눠 커밋하세요:  git restore --staged <다른 스코프 파일>"
  echo "-> 의도한 횡단 작업이면:        git commit --no-verify  (사유를 커밋 메시지에 반드시)"
  exit 1
fi
exit 0
