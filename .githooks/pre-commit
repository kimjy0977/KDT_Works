#!/bin/sh
# KDT pre-commit v5 — **혼합 스코프 커밋 거부** (세션 정체 불필요)
# 근거: 토론 TH-20260823-INFRA / v1~v3 결함을 실사용에서 연속 발견 후 재설계
#
# ★왜 세션 정체를 안 쓰는가 (v3까지의 실패)
#   v2 `.kdt-session` 파일 → 공유 clone에 파일 1개라 남이 덮어씀(실제 발생)
#   v3 $KDT_SESSION export → Bash 도구가 **호출마다 새 셸**이라 안 남음(튜터 실측)
#   → "3세션 1 clone"엔 **세션별 상태를 둘 곳이 자체가 없다.**
#
# ★그래서 질문을 바꾼다: "너 누구냐"(불가) → **"이 커밋이 스코프를 섞었냐"**(가능)
#   실제 사고 2건은 전부 **한 커밋에 두 스코프가 섞인 것**이었다:
#     · 매니저 08-23: 폴더개명(구조) + 게임코드(해커톤)
#     · 튜터 08-19: 문서(튜터) + 해커톤 미완성 파일
#   혼합만 막으면 **정체를 몰라도 두 사고가 다 걸린다.**
#
# ── v5 수정 (2026-08-27 · 빌더 KBTM-B-20260827-1 제보) ─────────────
# ★버그: **한글 파일명이 든 정상 커밋을 거부**했다.
#   git 은 기본(core.quotepath=true)에서 비ASCII 경로를 따옴표로 감싸고 8진 이스케이프한다:
#     "90_hackathon/.../SPUM-\355\214\200\352\260\200\354\235\264\353\223\234.md"
#   그러면 `case "$f" in 90_hackathon/*)` 가 **선두 따옴표 때문에 빗나가** other 로 떨어지고,
#   같은 커밋의 다른 파일과 합쳐져 "스코프 2개"로 오판된다.
#   → `git -c core.quotepath=false` 로 받는다.
# ★함께 고친 것: `for f in $FILES` 는 **공백 있는 파일명에서도 쪼개진다.**
#   IFS 를 개행만으로 한정해 막는다.
# ⚠빌더는 훅이 매니저 관할이라 **직접 고치지 않고 --no-verify 도 쓰지 않았다.** 옳은 처신이다.

# 비ASCII 경로 따옴표 방지 + 공백 파일명 대비(IFS=개행)
FILES=$(git -c core.quotepath=false diff --cached --name-only)
[ -z "$FILES" ] && exit 0

OLDIFS=$IFS
IFS='
'

SCOPES=""
for f in $FILES; do
  case "$f" in
    90_hackathon/*)                         S=hackathon ;;
    00_log/*|01_onboarding/*|0[2-9]_module*/*|99_domain-dev/*) S=content ;;
    index.html|README.md|assets/*|.githooks/*|.gitignore|.kdt-session*) S=structure ;;
    *)                                      S=other ;;
  esac
  case " $SCOPES " in *" $S "*) ;; *) SCOPES="$SCOPES $S" ;; esac
done

IFS=$OLDIFS

N=$(echo $SCOPES | wc -w)
if [ "$N" -gt 1 ]; then
  echo "[거부] 한 커밋에 스코프가 $N 개 섞였습니다:$SCOPES"
  echo ""
  git -c core.quotepath=false diff --cached --name-only | sed 's/^/   /'
  echo ""
  echo "실제 사고 2건이 전부 이 형태였습니다(개명 커밋에 게임코드 / 문서 커밋에 미완성 파일)."
  echo "-> 스코프별로 나눠 커밋하세요:  git restore --staged <다른 스코프 파일>"
  echo "-> 의도한 횡단 작업이면:        git commit --no-verify  (사유를 커밋 메시지에 반드시)"
  exit 1
fi

# ── v6 (2026-09-15 · 토론 TH-20260915-SCOPE E-5 · 튜터) ─────────────
# ★파생값 동행 검사 — 원본을 고치면 파생값도 «같은 커밋»에 (A-1)
#   경고만 한다. 차단하면 --no-verify 가 습관이 되고 훅 전체가 무력해진다.
#   판정 대상은 «파일 변경»이 아니라 «섹션 수 변화»다 — 상세는 스크립트 머리말에.
#   ★검사기를 .githooks/ 에 둔다(00_log 아님) — 훅과 «같이» 바뀌어야 하는 부품이라
#     스코프가 갈리면 훅과 부품이 다른 커밋으로 흩어진다. A-1 과 같은 문제다.
#     (실제로 v5 훅이 이 커밋을 «스코프 혼합»으로 거부해서 알았다)
if [ -f .githooks/파생값-동행검사.py ]; then
  if command -v python >/dev/null 2>&1; then
    python .githooks/파생값-동행검사.py || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 .githooks/파생값-동행검사.py || true
  else
    # ★못 돌렸으면 «조용히» 넘기지 않는다 — 그게 이 훅이 막으려는 실패 방식이다
    echo "[동행검사] ⚠ python 이 없어 검사를 «건너뛰었습니다»"
  fi
fi

exit 0
