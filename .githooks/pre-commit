#!/bin/sh
# KDT pre-commit — 세션 스코프 밖 스테이지 거부
# 근거: 토론 TH-20260823-INFRA 수렴v2 + **v3 결함수정(2026-08-23)**
# 배포: .githooks/ 커밋 + git config core.hooksPath .githooks
# ⚠ 한계: --no-verify 로 뚫린다. 실수 방지지 강제력이 아니다.
#
# ★v3 수정 — 세션 판정 우선순위:
#   ① 환경변수 $KDT_SESSION  (권장·세션별로 다름)
#   ② .kdt-session 1행       (폴백)
#   ★공유 clone이라 .kdt-session은 **파일 1개를 3세션이 공유**한다 →
#     남이 덮어쓰면 내 커밋이 남의 스코프로 검사된다(실제 발생 2026-08-23).
#     → 각 세션은 시작 시 `export KDT_SESSION=manager|tutor|hackathon` 할 것.

SESSION="$KDT_SESSION"
if [ -z "$SESSION" ] && [ -f ".kdt-session" ]; then
  SESSION=$(sed -n '1p' .kdt-session | tr -d '\r' | tr -d ' ')
fi
[ -z "$SESSION" ] && exit 0        # 선언 없으면 통과(옵트인)

case "$SESSION" in
  manager)   ALLOW='^(index\.html|README\.md|00_log/|assets/|\.githooks/|\.gitignore|\.kdt-session)' ;;
  tutor)     ALLOW='^(00_log/|01_onboarding/|02_module1/|03_module2/|99_domain-dev/)' ;;
  hackathon) ALLOW='^90_hackathon/' ;;
  *) echo "[pre-commit] 알 수 없는 세션 '$SESSION' — KDT_SESSION 또는 .kdt-session 확인"; exit 1 ;;
esac

BAD=$(git diff --cached --name-only | grep -vE "$ALLOW" || true)
if [ -n "$BAD" ]; then
  echo "[거부] 세션($SESSION) 스코프 밖 파일이 스테이지에 있습니다:"
  echo "$BAD" | sed 's/^/   /'
  echo "-> git restore --staged <파일> 로 빼거나, 소유 세션에 인계하세요."
  echo "-> 의도한 횡단 작업이면: git commit --no-verify (사유를 커밋 메시지에)"
  echo "-> 세션이 틀리게 잡혔으면: export KDT_SESSION=manager|tutor|hackathon"
  exit 1
fi
exit 0
